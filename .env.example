# Rushhour 환경설정 예시 — 이 파일을 `.env`로 복사해 값을 채우세요.
#   cp .env.example .env
# .env 는 gitignore 되어 커밋되지 않습니다. 값은 app/config.py(Settings)가 읽습니다.
# 우선순위: 실제 환경변수 > .env > 기본값 (환경변수로 언제든 덮어쓸 수 있음)

# ── LLM 채널 ────────────────────────────────────────────────────────────────
# local(기본, 코스 8080 서버) | gemini | openai | none(LLM 없이 규칙만)
AGENT_CHANNEL=local
# AGENT_BASE_URL=http://localhost:8080/v1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── 외부 API ────────────────────────────────────────────────────────────────
# 경로 질의의 출발/도착을 장소명·랜드마크('올림픽공원','롯데타워','강남역')로 주려면 필요.
# 카카오 developers > 내 애플리케이션 > REST API 키. 없으면 자치구명·'lat,lon'만 인식.
KAKAO_REST_API_KEY=

# ── 임베딩 / RAG (search_places — 동료 배선 후 소비) ──────────────────────────
# 코스 임베딩 서버: bash week4/start_embed_server.sh (포트 8082, bge-m3 1024차원).
# EMBED_URL=http://localhost:8082/v1/embeddings
# EMBED_MODEL=bge-m3

# ── 데이터 경로(기본값이면 생략 가능) ────────────────────────────────────────
# TREE_PARQUET=data/processed/seoul_trees.parquet
# TREE_CSV=data/seoul_tree_data.csv

# ── 백엔드(backend/) ─────────────────────────────────────────────────────────
# CHECKPOINT_DB=data/checkpoints.sqlite
# TRACE_BACKEND=jsonl                # jsonl | langfuse | none
# TRACE_PATH=results/rushhour_trace.jsonl

# ── UI / 데모 ────────────────────────────────────────────────────────────────
# RUSHHOUR_API=http://localhost:8000  # Streamlit UI가 호출할 백엔드 주소
# RUSHHOUR_SEASON=                     # spring|summer|autumn|winter — 데모용 계절 고정
